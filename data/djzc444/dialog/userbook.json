        {
            "translate": "djzc.dialog.wiki",
            "fallback": "点击查看冬季战场百科全书",
            "color":"green",
            "hover_event": {
                "action": "show_text",
                "value": {
                    "translate": "djzc.dialog.wiki.desc",
                    "fallback": "正在不断更新，欢迎进来看看"
                }
            },
            "click_event": {
                "action": "show_dialog",
                "dialog": "djzc444:wiki/wiki_notice"
            }
        }
    ]
    },
    {
        "type": "plain_message",
        "contents": 
        {
            "translate": "djzc.dialog.realtime",
