{
    "type":"multi_action",
    "pause": false,
    "title":[
    {
    "translate": "djzc.dialog.userbook",
    "fallback":"冬战成员用书",
    "hover_event": {
    "action": "show_text",
    "value": {
        "translate": "djzc.dialog.author1",
        "fallback": "冬战制作组 制作"
    }
    }
    }
    ],
    "body":[
    {
    "type":"plain_message",
